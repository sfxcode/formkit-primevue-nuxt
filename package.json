{
  "name": "@sfxcode/formkit-primevue-nuxt",
  "version": "1.8.3",
  "description": "FormKit PrimeVue nuxt module",
  "homepage": "https://github.com/sfxcode/formkit-primevue-nuxt",
  "repository": "https://github.com/sfxcode/formkit-primevue-nuxt",
  "license": "MIT",
  "type": "module",
  "build": {
    "failOnWarn": false
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "dev:start": "node playground/.output/server/index.mjs",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --patch --release && npm publish --access=public && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@formkit/nuxt": "^2.1.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@primevue/nuxt-module": "4.5.5",
    "@sfxcode/formkit-primevue": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "4.0.0-alpha.9",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/kit": "^4.5.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.1",
    "@nuxt/test-utils": "^4.1.0",
    "@primeuix/themes": "2.0.3",
    "@primevue/forms": "^4.5.5",
    "@types/node": "latest",
    "@unocss/nuxt": "^66.7.5",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.1",
    "typescript": "6.0.3",
    "unocss": "^66.7.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
